# App
APP_ENV=development
APP_SECRET_KEY=change-me
JWT_SECRET=change-me
SESSION_RETENTION_DAYS=30

# Database
DATABASE_URL=postgresql+psycopg://pathiq:pathiq@postgres:5432/pathiq
REDIS_URL=redis://redis:6379/0

# AI providers (adapters read these; choose providers in code config)
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
EMBEDDING_PROVIDER=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
STT_PROVIDER=
STT_API_KEY=
TTS_PROVIDER=
TTS_API_KEY=

# Behaviour
CONCERN_CONFIRM_THRESHOLD=0.70
RETRIEVAL_TOP_K=3
GROUNDING_MAX_RETRIES=1
SMALL_CELL_MIN=10
DEFAULT_LANGUAGES=hi,en
PILOT_REGION_LANGUAGE=

# Safety (verify before use; never hard-code from memory)
HELPLINE_CONFIG_PATH=config/helplines.json

# Frontend
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
