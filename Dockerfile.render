# =============================================================
# Stage 1: Build Frontend (Next.js)
# =============================================================
FROM node:20-bookworm-slim AS frontend-builder

WORKDIR /app/frontend

ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1 \
    INTERNAL_API_BASE=http://localhost:8000/api/v1

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# =============================================================
# Stage 2: Combined Runtime (Python 3.11-slim + Node.js 20)
# =============================================================
FROM python:3.11-slim AS runtime

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=10000 \
    NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1 \
    INTERNAL_API_BASE=http://localhost:8000/api/v1 \
    PYTHONPATH=/app/backend

# 1. Copy Node.js runtime and npm binaries from node:20-bookworm-slim
COPY --from=node:20-bookworm-slim /usr/local/bin /usr/local/bin
COPY --from=node:20-bookworm-slim /usr/local/lib/node_modules /usr/local/lib/node_modules

# 2. Install backend system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    curl \
    && rm -rf /var/lib/apt/lists/*

# 3. Install Python backend dependencies
COPY backend/pyproject.toml backend/README.md /app/backend/
RUN pip install --no-cache-dir -e "/app/backend[dev]"

# 4. Copy backend application source
COPY backend/app /app/backend/app
COPY backend/alembic /app/backend/alembic
COPY backend/alembic.ini /app/backend/alembic.ini
COPY backend/config /app/backend/config

# 5. Copy built frontend application and dependencies
COPY --from=frontend-builder /app/frontend /app/frontend

# 6. Copy and configure entrypoint script
COPY docker-entrypoint.sh /app/docker-entrypoint.sh
RUN sed -i 's/\r$//' /app/docker-entrypoint.sh && chmod +x /app/docker-entrypoint.sh

# 7. Expose FastAPI internal port (8000) and Render public port (10000)
EXPOSE 8000 10000

ENTRYPOINT ["/app/docker-entrypoint.sh"]
